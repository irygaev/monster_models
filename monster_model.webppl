var reverseConfusionProb = function(p_utt, i_utt, state, params)
{
  var utt_probs = reverseConfusionProbs(p_utt, state, params)
  return utt_probs[utterances.indexOf(i_utt)]
}

var intendedUtterancePosterior = function(p_utt, state, params)
{
  var utt_priors = reverseConfusionProbs(p_utt, state, params)
  return Categorical({ps: utt_priors, vs: utterances})
}

var intendedUtterancePosteriorSlow = function(p_utt, state, params)
{
  Infer({method: 'enumerate', model: function() {
    var i_utt = utteranceByPrior(state, params)
    condition(p_utt === perceivedUtteranceSample(i_utt, params))
    return i_utt
  }})
}

var doubleConfusionProbs = function(speaker_i_utt, state, params)
{
  var utt_weights = map(function(i_utt)
    {
      return sum(map(function(p_utt)
        {
          return confusionProb(speaker_i_utt, p_utt, params) * reverseConfusionProb(p_utt, i_utt, state, params)
        },
        utterances
      ))
    },
    utterances
  )

  var utt_probs = map(function(x) { return x / sum(utt_weights)}, utt_weights)

  return utt_probs
}

var doubleConfusionProb = function(speaker_i_utt, listener_i_utt, state, params)
{
  var utt_probs = doubleConfusionProbs(speaker_i_utt, state, params)
  return utt_probs[utterances.indexOf(listener_i_utt)]
}

var meaning_table = {
  agent_falls: {the_agent: 1, the_patient: 0, it: 1, zero: 1},
  patient_falls: {the_agent: 0, the_patient: 1, it: 1, zero: 0}
}

// meaning function to interpret the utterances
var meaning = function(utterance, state){
  meaning_table[state][utterance]
}

//var jump_over_beta = DiscreteBeta(0.5451610, 0.6961924)
//var wave_bate = DiscreteBeta(1.1358936, 0.6326076)
//var attack_beta = DiscreteBeta(1.0033267, 0.4721537)
//var throw_rock_beta = DiscreteBeta(2.970715, 0.198752)

var actionPrior = function(action, action_prior)
{
  if (action_prior != -1)
  {
    return action_prior
  }
  else
  {
    return action_priors[action]
    /*return (action == 'jump_over') ? sample(jump_over_beta) :
      (action == 'wave') ? sample(wave_bate) :
      (action == 'attack') ? sample(attack_beta) :
      (action == 'throw_rock') ? sample(throw_rock_beta) :
      0.5*/
  }
}

var statePrior = function(params)
{
  var p1 = actionPrior(params.action, params.action_prior)

  var p2 = 1 - params.salience_prior

  var p3 =
    params.event_type == "postsurprising" ?
      params.patient_color == 'blue' ? params.revision_prior :
      params.patient_color == 'red' ? 1 - params.revision_prior :
      0.5 :
    params.patient_color == 'blue' ? params.train_prior :
    params.patient_color == 'red' ? 1 - params.train_prior :
    0.5
  
  return p1 * p2 * p3 / (p1 * p2 * p3 + (1 - p1) * (1 - p2) * (1 - p3)) // patient falling probability
}

var stateByPriors = function(params)
{
  var p = statePrior(params)
  
  var state_id = +flip(p)
  return states[state_id]
}


// DIRECT AND INVERSE RSA

// literal speaker
var speaker0 = function(state, params)
{
  Infer({model: function()
  {
    var utterance = utteranceByPrior(state, params)
    condition(meaning(utterance, state))
    return utterance
  }})
}

var literalSpeaker = speaker0

// literal listener
var listener0_sample = function(utterance, params)
{
  Infer
  (
    {
      model: function()
      {
        var state = stateByPriors(params)
        var i_utt = sample(intendedUtterancePosterior(utterance, state, params))
        condition(meaning(i_utt, state))
        return state
      }
    }
  )
}

var listener0_sum = function(utterance, params)
{
  Infer
  (
    {
      model: function()
      {
        var state = stateByPriors(params)

        var utility = sum
        (
          map
          (
            function(i_utt)
            {
              var utterance_prior = utterancePrior(i_utt, state, params)
              var confusion_prob = confusionProb(i_utt, utterance, params)
              var likelihood = meaning(i_utt, state)
              return utterance_prior * confusion_prob * likelihood
            },
            utterances
          )
        )

        factor(Math.log(utility))

        return state
      }
    }
  )
}

var listener0 = listener0_sum

var literalListener = listener0

// higher order speaker
var speakerN_full = function(n, state, params)
{
  if (n == 0)
  {
    return speaker0(state, params)
  }
  else
  {
    var salience_prior = (state == 'agent_falls' || params.agent_bias == -1 ? params.salience_prior : params.agent_bias)
    var action_prior = (state == 'agent_falls' || params.replacement_prior == -1 ? params.action_prior : 1 - params.replacement_prior)
    //var action_prior = (state == 'agent_falls' ? params.action_prior : params.action_prior * params.replacement_prior)

    var patient_color_0 =
      (params.event_type == "familiar")   ? (state == 'patient_falls') ? ('blue') : ('red') :
      (params.event_type == "surprising") ? (state == 'patient_falls') ? ('red') : ('blue'):
      (params.event_type == "postsurprising") ? (state == 'patient_falls') ? ('blue') : ('red'):
      ('yellow')

    //var patient_color = patient_color_0
    var patient_color = (state == 'agent_falls' || params.replacement_prior == -1 ? patient_color_0 : 'yellow')

    //var listener_params = Object.assign({}, params, {salience_prior: salience_prior, patient_color: patient_color})
    var listener_params = Object.assign({}, params, {action_prior: action_prior, salience_prior: salience_prior, patient_color: patient_color})

    Infer({model: function()
    {
      var utterance = utteranceByPrior(state, params)

      var utility = sum
      (
        map
        (
          function(p_utt)
          {
            var confusion_prob = confusionProb(utterance, p_utt, params)
            var likelihood = listenerN(n - 1, p_utt, listener_params).score(state)
            return confusion_prob == 0 ? 0 : confusion_prob * likelihood
          },
          utterances
        )
      )
      
      factor(params.alpha == 0 ? 0 : params.alpha * utility)

      return utterance
    }
    })
  }
}

var speakerN_simple = function(n, state, params)
{
  if (n == 0)
  {
    return speaker0(state, params)
  }
  else if (state == 'patient_falls')
  {
    var p_np = params.p_np
    var p_pro = (1 - p_np) * params.p_pro
    var p_zero = 1 - p_np - p_pro

    return Categorical({ps: [0, p_np, p_pro, p_zero], vs: utterances})
  }
  else
  {
    var patient_color =
      (params.event_type == "familiar")   ? (state == 'patient_falls') ? ('blue') : ('red') :
      (params.event_type == "surprising") ? (state == 'patient_falls') ? ('red') : ('blue'):
      (params.event_type == "postsurprising") ? (state == 'patient_falls') ? ('blue') : ('red'):
      ('yellow')

    //var listener_params = Object.assign({}, params, {salience_prior: salience_prior, patient_color: patient_color})
    var listener_params = Object.assign({}, params, {patient_color: patient_color})

    Infer({model: function()
    {
      var utterance = utteranceByPrior(state, params)

      var utility = sum
      (
        map
        (
          function(p_utt)
          {
            var confusion_prob = confusionProb(utterance, p_utt, params)
            var likelihood = listenerN(n - 1, p_utt, listener_params).score(state)
            return confusion_prob == 0 ? 0 : confusion_prob * likelihood
          },
          utterances
        )
      )
      
      factor(params.alpha == 0 ? 0 : params.alpha * utility)

      return utterance
    }
    })
  }
}

var speakerN = speakerN_simple

// higher order listener
var listenerN_sample = function(n, utterance, params)
{
  if (n == 0)
  {
    return listener0(utterance, params)
  }
  else
  {
    Infer
    (
      {
        model: function()
        {
          var state = stateByPriors(params)
          var i_utt = sample(intendedUtterancePosterior(utterance, state, params))
          observe(speakerN(n - 1, state, params), i_utt)
          return state
        }
      }
    )
  }
}

var listenerN_sum = function(n, utterance, params)
{
  if (n == 0)
  {
    return listener0(utterance, params)
  }
  else
  {
    Infer
    (
      {
        model: function()
        {
          var state = stateByPriors(params)

          var utility = sum
          (
            map
            (
              function(i_utt)
              {
                var utterance_prior = utterancePrior(i_utt, state, params)
                var confusion_prob = confusionProb(i_utt, utterance, params)
                var likelihood = Math.exp(speakerN(n - 1, state, params).score(i_utt))
                return utterance_prior * confusion_prob * likelihood
              },
              utterances
            )
          )

          factor(Math.log(utility))

          return state
        }
      }
    )
  }
}

var listenerN = listenerN_sum

// direct pragmatic speaker
var speaker1 = function(state, params)
{
  return speakerN(1, state, params)
}

var pragmaticSpeaker = speaker1

// direct pragmatic listener
var listener2 = function(utterance, params)
{
  return listenerN(2, utterance, params)
}

var pragmaticListener = listener2

// direct hyperpragmatic speaker
var speaker3 = function(state, params)
{
  return speakerN(3, state, params)
}

// inverse pragmatic listener
var listener1 = function(utterance, params)
{
  return listenerN(1, utterance, params)
}

var inversePragmaticListener = listener1

// inverse pragmatic speaker
var speaker2 = function(state, params)
{
  return speakerN(2, state, params)
}

var inversePragmaticSpeaker = speaker2


////////////////
// Data Analysis
////////////////

var modelMainExps = function(fitting_params, fixed_params)
{
  var alpha = uniform({a:0, b:10});

  // potantially different alphas for different production conditions, to be removed
  //var alpha_familiar = alpha//uniform({a:1, b:10});
  //var alpha_surprising = alpha//uniform({a:1, b:10});
  //var alpha_postsurprising = alpha//uniform({a:1, b:10});
  //var alpha_neutral = alpha//uniform({a:1, b:10});

  // utterance costs in relation to zero anaphors
  var np_cost = (fitting_params.cost == "np" || fitting_params.cost == "both") ? uniform({a:0, b:1}) : (0)
  var pro_cost = (fitting_params.cost == "pro" || fitting_params.cost == "both") ? uniform({a:0, b:1}) : (0)

  // listener noise
  var certain_clean = (fitting_params.n_noise_levels < 1) ? 0.99 : uniform({a:0, b:1})
  var certain_clean_it = (fitting_params.n_noise_levels < 1) ? 0.99 : uniform({a:0, b:1})
  var certain_low = (fitting_params.n_noise_levels < 2) ? certain_clean : uniform({a:0, b:1})
  var certain_low_it = (fitting_params.n_noise_levels < 2) ? certain_clean_it : uniform({a:0, b:1})
  var certain_high = (fitting_params.n_noise_levels < 3) ? certain_low : uniform({a:0, b:1})
  var certain_high_it = (fitting_params.n_noise_levels < 3) ? certain_low_it : uniform({a:0, b:1})

  // speaker-assumed noise
  var certain_zero = (fitting_params.n_noise_levels < 4) ? certain_low : uniform({a:0, b:1})
  var certain_it = (fitting_params.n_noise_levels < 4) ? certain_low_it : uniform({a:0, b:1})
  //var certain_surp = certain_zero//uniform({a:0, b:1}) // potentially different for surprising events, to be removed
  //var certain_surp_it = certain_it//uniform({a:0, b:1})

  var salience_prior = 0.5//uniform({a:0, b:1}) // preference to refer to the agent
  var replacement_prior = uniform({a:0, b:1}) // flat action prior for patient_falls state
  var agent_bias = -1//uniform({a:0, b:1}) // something strange (replacement for salient prior for patient_falls state), to be removed
  var np_bias = 0.5//uniform({a:0, b:1}) // speaker's preference to use NP to refer to the agent
  var np_bias2 = 0.5//uniform({a:0, b:1}) // speaker's prefernece to use NP to refer to the patient
  
  // action priors
  var jump_over_prior = uniform({a:0, b:1})
  var wave_prior = uniform({a:0, b:1})
  var attack_prior = uniform({a:0, b:1})
  var throw_rock_prior = uniform({a:0, b:1})
  var overall_prior = uniform({a:0, b:1}) // "average" action
  
  var train_prior = uniform({a:0, b:1}) // monster strength prior for familiar and surprising events
  var revision_prior = uniform({a:0, b:1}) // monster strength prior for postsurprising events

  var p_np = uniform({a:0, b:1}) // fixed probability of producing an NP for patient falls state
  var p_pro = uniform({a:0, b:1}) // fixed probability of producing a pronoun vs zero anaphor for patient falls state
  
  var random_params = {
      alpha: alpha,
      //alpha_familiar: alpha_familiar,
      //alpha_surprising: alpha_surprising,
      //alpha_postsurprising: alpha_postsurprising,
      //alpha_neutral: alpha_neutral,
      certain_zero: certain_zero,
      certain_it: certain_it,
      //certain_surp: certain_surp,
      //certain_surp_it: certain_surp_it,
      certain_clean: certain_clean,
      certain_clean_it: certain_clean_it,
      certain_low: certain_low,
      certain_low_it: certain_low_it,
      certain_high: certain_high,
      certain_high_it: certain_high_it,
      salience_prior: salience_prior,
      replacement_prior: replacement_prior,
      agent_bias: agent_bias,
      np_bias: np_bias,
      np_bias2: np_bias2,
      np_cost: np_cost,
      pro_cost: pro_cost,
      jump_over_prior: jump_over_prior,
      wave_prior: wave_prior,
      attack_prior: attack_prior,
      throw_rock_prior: throw_rock_prior,
      overall_prior: overall_prior,
      train_prior: train_prior,
      revision_prior: revision_prior,
      p_np: p_np,
      p_pro: p_pro,
    }

  var params = Object.assign({}, random_params, fixed_params) // override random parameters by given fixed ones

  var local_action_priors = {jump_over: params.jump_over_prior, wave: params.wave_prior, attack: params.attack_prior, throw_rock: params.throw_rock_prior, overall: params.overall_prior}
  //var local_action_priors = action_priors

  var speaker_training = []/*map
  (
    function(action)
    {
      return {
        data: prod_data_training[action],
        params: {
          event_type: "neutral",
          action: action,
          alpha: params.alpha_prod,
          certain_zero: params.certain_zero,
          certain_it: params.certain_it,
          salience_prior: params.salience_prior,
          replacement_prior: params.replacement_prior,
          agent_bias: params.agent_bias,
          np_bias: params.np_bias,
          np_bias2: params.np_bias2,
          action_prior: local_action_priors[action],
          train_prior: params.train_prior,
          revision_prior: params.revision_prior,
          np_cost: params.np_cost,
          pro_cost: params.pro_cost
        },
        speaker: fitting_params.speaker,
        states: states,
        utterances: utterances
      }
    },
    fitting_params.actions
  )*/

  var speaker_familiar = map
  (
    function(action)
    {
      return {
        data: prod_data_training_familiar[action],
        params: {
          event_type: "familiar",
          action: action,
          alpha: params.alpha,
          certain_zero: params.certain_zero,
          certain_it: params.certain_it,
          salience_prior: params.salience_prior,
          replacement_prior: params.replacement_prior,
          agent_bias: params.agent_bias,
          np_bias: params.np_bias,
          np_bias2: params.np_bias2,
          action_prior: local_action_priors[action],
          train_prior: params.train_prior,
          revision_prior: params.revision_prior,
          np_cost: params.np_cost,
          pro_cost: params.pro_cost,
          p_np: params.p_np,
          p_pro: params.p_pro
        },
        speaker: fitting_params.speaker,
        states: states,
        //states: ["agent_falls"],
        utterances: utterances
      }
    },
    fitting_params.actions
  )

  var speaker_surprising = map
  (
    function(action)
    {
      return {
        data: prod_data_training_surprising[action],
        params: {
          event_type: "surprising",
          action: action,
          alpha: params.alpha,
          certain_zero: params.certain_zero,
          certain_it: params.certain_it,
          salience_prior: params.salience_prior,
          replacement_prior: params.replacement_prior,
          agent_bias: params.agent_bias,
          np_bias: params.np_bias,
          np_bias2: params.np_bias2,
          action_prior: local_action_priors[action],
          train_prior: params.train_prior,
          revision_prior: params.revision_prior,
          np_cost: params.np_cost,
          pro_cost: params.pro_cost,
          p_np: params.p_np,
          p_pro: params.p_pro
        },
        speaker: fitting_params.speaker,
        states: states,
        //states: ["agent_falls"],
        utterances: utterances
      }
    },
    fitting_params.actions
  )

  var speaker_postsurprising = map
  (
    function(action)
    {
      return {
        data: prod_data_training_postsurprising[action],
        params: {
          event_type: "postsurprising",
          action: action,
          alpha: params.alpha,
          certain_zero: params.certain_zero,
          certain_it: params.certain_it,
          salience_prior: params.salience_prior,
          replacement_prior: params.replacement_prior,
          agent_bias: params.agent_bias,
          np_bias: params.np_bias,
          np_bias2: params.np_bias2,
          action_prior: local_action_priors[action],
          train_prior: params.train_prior,
          revision_prior: params.revision_prior,
          np_cost: params.np_cost,
          pro_cost: params.pro_cost,
          p_np: params.p_np,
          p_pro: params.p_pro
        },
        speaker: fitting_params.speaker,
        states: states,
        //states: ["agent_falls"],
        utterances: utterances
      }
    },
    fitting_params.actions
  )

  var speaker_no_training = map
  (
    function(action)
    {
      return {
        data: prod_data_no_training_rest[action],
        params: {
          event_type: "neutral",
          action: action,
          alpha: params.alpha,
          certain_zero: params.certain_zero,
          certain_it: params.certain_it,
          salience_prior: params.salience_prior,
          replacement_prior: params.replacement_prior,
          agent_bias: params.agent_bias,
          np_bias: params.np_bias,
          np_bias2: params.np_bias2,
          action_prior: local_action_priors[action],
          train_prior: params.train_prior,
          revision_prior: params.revision_prior,
          np_cost: params.np_cost,
          pro_cost: params.pro_cost,
          p_np: params.p_np,
          p_pro: params.p_pro
        },
        speaker: fitting_params.speaker,
        states: states,
        //states: ["agent_falls"],
        utterances: utterances
      }
    },
    fitting_params.actions
  )

  var speaker_experiments = fitting_params.speaker === null ? [] : speaker_training.concat(speaker_familiar.concat(speaker_surprising.concat(speaker_postsurprising.concat(speaker_no_training))))

  var listener_clean = map
  (
    function(action)
    {
      return {
        data: perc_data_clean[action],
        params: {
          event_type: "neutral",
          action: action,
          alpha: params.alpha,
          certain_zero: params.certain_clean,
          certain_it: params.certain_clean_it,
          salience_prior: params.salience_prior,
          replacement_prior: params.replacement_prior,
          agent_bias: params.agent_bias,
          np_bias: params.np_bias,
          np_bias2: params.np_bias2,
          action_prior: local_action_priors[action],
          train_prior: params.train_prior,
          revision_prior: params.revision_prior,
          np_cost: params.np_cost,
          pro_cost: params.pro_cost,
          p_np: params.p_np,
          p_pro: params.p_pro
        },
        listener: fitting_params.listener,
        states: states,
        utterances: ["it", "zero"]
      }
    },
    fitting_params.actions
  )

  var listener_low_noise = map
  (
    function(action)
    {
      return {
        data: perc_data_low_noise[action],
        params: {
          event_type: "neutral",
          action: action,
          alpha: params.alpha,
          certain_zero: params.certain_low,
          certain_it: params.certain_low_it,
          salience_prior: params.salience_prior,
          replacement_prior: params.replacement_prior,
          agent_bias: params.agent_bias,
          np_bias: params.np_bias,
          np_bias2: params.np_bias2,
          action_prior: local_action_priors[action],
          train_prior: params.train_prior,
          revision_prior: params.revision_prior,
          np_cost: params.np_cost,
          pro_cost: params.pro_cost,
          p_np: params.p_np,
          p_pro: params.p_pro
        },
        listener: fitting_params.listener,
        states: states,
        utterances: ["it", "zero"]
      }
    },
    fitting_params.actions
  )

  var listener_high_noise = map
  (
    function(action)
    {
      return {
        data: perc_data_high_noise[action],
        params: {
          event_type: "neutral",
          action: action,
          alpha: params.alpha,
          certain_zero: params.certain_high,
          certain_it: params.certain_high_it,
          salience_prior: params.salience_prior,
          replacement_prior: params.replacement_prior,
          agent_bias: params.agent_bias,
          np_bias: params.np_bias,
          np_bias2: params.np_bias2,
          action_prior: local_action_priors[action],
          train_prior: params.train_prior,
          revision_prior: params.revision_prior,
          np_cost: params.np_cost,
          pro_cost: params.pro_cost,
          p_np: params.p_np,
          p_pro: params.p_pro
        },
        listener: fitting_params.listener,
        states: states,
        utterances: ["it", "zero"]
      }
    },
    fitting_params.actions
  )

  var listener_experiments = fitting_params.listener === null ? [] : listener_clean.concat(listener_low_noise.concat(listener_high_noise))

  return {
    params: params,
    speaker_experiments: speaker_experiments,
    listener_experiments: listener_experiments
  }
}

var speakerTrialParams = function(experiment, state)
{
  /*var patient_color =
      (experiment.event_type == "familiar")   ? (state == 'patient_falls') ? ('blue') : ('red') :
      (experiment.event_type == "surprising") ? (state == 'patient_falls') ? ('red') : ('blue'):
      (experiment.event_type == "postsurprising") ? (state == 'patient_falls') ? ('blue') : ('red'):
      ('yellow')

  return {patient_color: patient_color}*/
  return {}
}

var listenerTrialParams = function(experiment, utterance)
{
  return {patient_color: "yellow"}
}

var dataAnalysis = function(model_generator, fitting_params, fixed_params)
{
  var model = model_generator(fitting_params, fixed_params)

  var results = {
    speaker:
      map(function(experiment){
        map(function(state){ 
              
          var speaker = experiment.speaker

          var speaker_predictions = speaker(state, Object.assign({}, experiment.params, speakerTrialParams(experiment, state)))
          var speaker_data = experiment.data[state]

          var utt_probs = map(function(utterance){ return Math.exp(speaker_predictions.score(utterance)) }, _.keys(speaker_data))
          var utt_count = map(function(utterance){ return speaker_data[utterance] }, _.keys(speaker_data))

          observe(Multinomial({n: sum(utt_count), ps: utt_probs}), utt_count)
          return {predictions: multinomial({n: sum(utt_count), ps: utt_probs}), score: Multinomial({n: sum(utt_count), ps: utt_probs}).score(utt_count)}
        },
        experiment.states)
      },
      model.speaker_experiments),
    
    listener:
      map(function(experiment){
        map(function(utterance){ 

          var listener = experiment.listener

          var listener_predictions = listener(utterance, Object.assign({}, experiment.params, listenerTrialParams(experiment, utterance)))
          var listener_data = experiment.data[utterance]

          var int_probs = map(function(state){ return Math.exp(listener_predictions.score(state)) }, _.keys(listener_data))
          var int_count = map(function(state){ return listener_data[state] }, _.keys(listener_data))

          observe(Multinomial({n: sum(int_count), ps: int_probs}), int_count)
          return {predictions: multinomial({n: sum(int_count), ps: int_probs}), score: Multinomial({n: sum(int_count), ps: int_probs}).score(int_count)}
        },
        experiment.utterances)
      },
      model.listener_experiments)
  }
  
  return Object.assign({}, model.params, {samples: results}) // return both calculated parameters and sample predictions
}

var estimateAndSample = function(model_generator, fitting_params, fixed_params, n_samples, n_burn_samples, to_sample, filename)
{
  //var burn_samples = 10000

  var parameter_estimation = Infer({
    method: "MCMC",
    //onlyMAP: true,
    samples: n_samples,
    burn: n_burn_samples,
    model: function() {dataAnalysis(model_generator, fitting_params, fixed_params)}})

  //viz(parameter_estimation)
  //viz.marginals(parameter_estimation)

  //var marginalAlpha = marginalize(parameter_estimation, 'alpha');
  //viz(marginalAlpha); 
  
  // Project down to only the two parameters of interest
  //var jointAB = Marginal(ize)(fullDist, function(x) {
    //return [x.a, x.b]; 
  //});

  // Visualize the isolated joint distribution
  //viz(jointAB);

  var params_array = []

  map(
    function(param)
    {
      if (param != 'samples' && param != 'score')
        params_array.push([param, expectation(marginalize(parameter_estimation, param))])
    },
    _.keys(parameter_estimation.samples[0].value)
  )

  var samples = map(function(x) { x.value.samples }, parameter_estimation.samples)

  if (to_sample)
  {
    var speaker = map(function(x) { map(function(y) {map(function(z) {z.predictions}, y)}, x.speaker) }, samples)
    var listener = map(function(x) { map(function(y) {map(function(z) {z.predictions}, y)}, x.listener) }, samples)
    var zip = map2(function(s, l) {return {speaker: s, listener: l}}, speaker, listener)
    json.write(filename, zip)
    print("sample saved")
  }

  var speaker = map(function(x) { sum(map(function(y) {sum(map(function(z) {z.score}, y))}, x.speaker)) }, samples)
  var listener = map(function(x) { sum(map(function(y) {sum(map(function(z) {z.score}, y))}, x.listener)) }, samples)
  var zip = map2(function(s, l) {return Math.exp(s + l)}, speaker, listener)
  params_array.push(['score', listMean(zip)])

  return Object.fromEntries(params_array)
}

var modelScoreSample = function(model_generator, fitting_params, fixed_params)
{
  var model = model_generator(fitting_params, fixed_params)

  var speaker_score = sum(
    map(function(experiment){
      return sum(
        map(function(state){

          var speaker = experiment.speaker

          var speaker_predictions = speaker(state, Object.assign({}, experiment.params, speakerTrialParams(experiment, state)))
          var speaker_data = experiment.data[state]

          var utt_probs = map(function(utterance){ return Math.exp(speaker_predictions.score(utterance)) }, _.keys(speaker_data))
          var utt_count = map(function(utterance){ return speaker_data[utterance] }, _.keys(speaker_data))

          return Multinomial({n: sum(utt_count), ps: utt_probs}).score(utt_count)
        },
        experiment.states))
    },
    model.speaker_experiments))

  var listener_score = sum(
    map(function(experiment){
      return sum(
        map(function(utterance){

          var listener = experiment.listener

          var listener_predictions = listener(utterance, Object.assign({}, experiment.params, listenerTrialParams(experiment, utterance)))
          var listener_data = experiment.data[utterance]

          var int_probs = map(function(state){ return Math.exp(listener_predictions.score(state)) }, _.keys(listener_data))
          var int_count = map(function(state){ return listener_data[state] }, _.keys(listener_data))

          return Multinomial({n: sum(int_count), ps: int_probs}).score(int_count)

        },
        experiment.utterances))
    },
    model.listener_experiments))

  return Math.exp(speaker_score + listener_score)
}

var modelScore = function(model_generator, fitting_params, fixed_params, n_samples)
{
  var score = expectation
  (
    Infer
    (
      {
        method: "forward",
        samples: n_samples,
        model: function() {modelScoreSample(model_generator, fitting_params, fixed_params)}
      }
    )
  )

  return score
}

